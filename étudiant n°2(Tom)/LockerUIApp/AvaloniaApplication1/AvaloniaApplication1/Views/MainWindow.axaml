<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="AvaloniaLockerApp.Views.MainWindow"
        Title="Locker Raspberry"
        Width="800"
        Height="550"
        CanResize="False">

    <ScrollViewer>
        <StackPanel Margin="25" Spacing="8">

            <TextBlock Text="LOCKER"
                       FontSize="30"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Application de gestion des casiers"
                       FontSize="15"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

            <!-- Partie fonctionnement normal -->
            <TextBlock Text="Code de retrait :"
                       FontSize="17"/>

            <TextBox x:Name="txtCode"
                     Watermark="Saisir le code"
                     FontSize="18"
                     Height="40"/>

            <TextBlock Text="Casier associé :"
                       FontSize="17"/>

            <TextBlock x:Name="txtCasier"
                       Text="Aucun casier sélectionné"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,5"/>

            <TextBlock Text="État du casier :"
                       FontSize="17"/>

            <TextBlock x:Name="txtEtatCasier"
                       Text="En attente d'un code"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>

            <Button x:Name="btnValiderCode"
                    Content="Valider / Déverrouiller"
                    Height="42"
                    FontSize="16"/>

            <Button x:Name="btnFermerCasier"
                    Content="Verrouiller le casier"
                    Height="42"
                    FontSize="16"/>

            <!-- Accès maintenance -->
            <TextBlock Text="Accès maintenance :"
                       FontSize="17"
                       Margin="0,10,0,0"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="txtMotDePasseMaintenance"
                         Watermark="Code maintenance"
                         PasswordChar="*"
                         Width="220"
                         Height="35"/>

                <Button x:Name="btnConnexionMaintenance"
                        Content="Connexion"
                        Width="120"
                        Height="35"/>

                <Button x:Name="btnDeconnexionMaintenance"
                        Content="Déconnexion"
                        Width="120"
                        Height="35"
                        IsVisible="False"/>
            </StackPanel>

            <!-- Partie maintenance cachée au démarrage -->
            <StackPanel x:Name="panelMaintenance"
                        IsVisible="False"
                        Spacing="8">

                <TextBlock Text="Mode maintenance : test manuel des casiers"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,8,0,0"/>

                <StackPanel Orientation="Horizontal" Spacing="8">

                    <ComboBox x:Name="comboCasierTest"
                              SelectedIndex="0"
                              Width="130"
                              Height="35">
                        <ComboBoxItem Content="Casier 1"/>
                        <ComboBoxItem Content="Casier 2"/>
                        <ComboBoxItem Content="Casier 3"/>
                        <ComboBoxItem Content="Casier 4"/>
                    </ComboBox>

                    <Button x:Name="btnTestDeverrouiller"
                            Content="Tester déverrouillage"
                            Width="190"
                            Height="35"/>

                    <Button x:Name="btnTestVerrouiller"
                            Content="Tester verrouillage"
                            Width="170"
                            Height="35"/>
                </StackPanel>

                <!-- Logs visibles seulement en maintenance -->
                <TextBlock Text="Logs maintenance :"
                           FontSize="16"
                           Margin="0,6,0,0"/>

                <TextBox x:Name="txtLogs"
                         Height="120"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         FontSize="13"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>